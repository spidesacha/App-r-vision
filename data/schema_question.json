{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Question",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "chapitre",
  "type",
  "angle",
  "fait",
  "enonce",
  "propositions",
  "bonnes",
  "explication",
  "source"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^b[cm]0[1-9]-q\\d{3}$"
  },
  "chapitre": {
   "type": "string",
   "pattern": "^b[cm]0[1-9]$"
  },
  "type": {
   "enum": [
    "QCS",
    "QCM"
   ]
  },
  "angle": {
   "enum": [
    "definition",
    "chiffre",
    "comparaison",
    "vrai_faux",
    "intrus",
    "ordre",
    "cas_pratique",
    "schema_decrit",
    "identification",
    "association"
   ]
  },
  "fait": {
   "type": "string",
   "minLength": 8
  },
  "enonce": {
   "type": "string",
   "minLength": 10
  },
  "propositions": {
   "type": "array",
   "minItems": 4,
   "maxItems": 5,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "bonnes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer",
    "minimum": 0,
    "maximum": 4
   },
   "uniqueItems": true
  },
  "explication": {
   "type": "string",
   "minLength": 10
  },
  "source": {
   "type": "object",
   "required": [
    "chapitre",
    "diapo"
   ],
   "additionalProperties": false,
   "properties": {
    "chapitre": {
     "type": "string"
    },
    "diapo": {
     "type": "integer",
     "minimum": 1
    }
   }
  }
 }
}